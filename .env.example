# ========================================================
# HoneyChain Production Environment Configuration Example
# Copy this file to '.env' for local secrets (do NOT commit .env to GitHub)
# ========================================================

# Secret key for cryptographically signing Flask session cookies
# Generate a strong 64-char key in python using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-cryptographically-secure-random-key-in-production

# Public base URL of your deployed application (NO trailing slash)
# Example for Render: https://honeychain.onrender.com
# Example for custom domain: https://trace.yourdomain.com
# This URL is used to generate live QR codes for honey jars so mobile phone cameras open the public site.
PUBLIC_BASE_URL=https://honeychain.onrender.com

# Environment mode: production or development
FLASK_ENV=production

# Server listening port (provided automatically by Render, Railway, etc.)
PORT=5000

# Optional: Path to SQLite database file
# On Render with a Persistent Disk attached at /var/data, set:
# DATABASE_PATH=/var/data/honeychain.db
# Default when unset: instance/honeychain.db
DATABASE_PATH=instance/honeychain.db
